# Client (Vite) - safe to expose
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SITE_URL=http://localhost:5173

# Server only (Vercel env vars, NEVER commit, never prefix with VITE_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL="AI Tools Hub <news@yourdomain.com>"
RESEND_WEBHOOK_SECRET=
SITE_URL=https://yourdomain.com
# Vercel Cron automatically sends this as "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=

# Discovery agent (server only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Optional: Product Hunt developer token (adds Product Hunt launches as a source)
PRODUCT_HUNT_TOKEN=
